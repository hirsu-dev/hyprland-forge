#!/usr/bin/env bash
set -euo pipefail
[[ -f /etc/forge-live && -d /run/archiso ]] || exit 1
export PYTHONPATH=/opt/hyprland-forge
export QT_QUICK_CONTROLS_STYLE=Basic
export QT_QUICK_BACKEND=software
xset s off
xset -dpms || true
openbox &
exec systemd-inhibit --what=sleep:idle:handle-lid-switch --mode=block --who='Forge Setup' --why='Installing the operating system' python -m forge.iso_welcome
