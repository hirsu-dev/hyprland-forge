#!/usr/bin/env python3
import os
import signal
import subprocess
import sys
from pathlib import Path

name = Path(sys.argv[0]).name
root = Path(os.environ["FORGE_SESSION_FIXTURE"])
if name in ("systemctl", "dbus-update-activation-environment"):
    sys.exit(1)
if name == "hyprctl":
    sys.exit(0 if (root / "active").exists() else 1)
if name == "systemd-detect-virt":
    print("oracle")
    sys.exit(0)
if name == "quickshell":
    (root / "renderer").write_text(os.environ.get("QT_QUICK_BACKEND", ""))
    child = subprocess.Popen([sys.executable, "-c", "import signal; signal.pause()"])
    (root / "child-process").write_text(str(child.pid))
try:
    os.fstat(9)
except OSError:
    pass
else:
    (root / "leaked-lock").touch()
identity = name + ("-" + sys.argv[2] if name == "wl-paste" else "")
(root / (identity + ".pid")).write_text(str(os.getpid()))
def stop(signum, frame):
    (root / (identity + ".stopped")).touch()
    sys.exit(0)
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
signal.pause()
