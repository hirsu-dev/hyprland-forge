#!/usr/bin/env python3
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".local/lib/hyprland-forge"))
from forge.hardware import virtualization

environment = dict(os.environ)
if virtualization():
    environment["LIBGL_ALWAYS_SOFTWARE"] = "1"
os.execvpe("hyprlock", ["hyprlock", "--grace", "0", *sys.argv[1:]], environment)
