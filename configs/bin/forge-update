#!/usr/bin/env bash
set -euo pipefail
[[ "$(uname -s)" == Linux && -f /etc/arch-release && $EUID -ne 0 ]] || exit 1
printf '%s\n' 'Forge full system update. Review pacman prompts; config rollback does not undo packages.'
sudo pacman -Syu
printf '%s\n' 'Update finished. Press Enter to close.'
read -r
