#!/usr/bin/env bash
set -euo pipefail
[[ $# -gt 0 ]] || exit 1
if command -v prime-run >/dev/null 2>&1 && command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
    exec systemd-inhibit --what=idle --mode=block --why='Forge gaming session' prime-run gamemoderun "$@"
fi
exec systemd-inhibit --what=idle --mode=block --why='Forge gaming session' gamemoderun "$@"
